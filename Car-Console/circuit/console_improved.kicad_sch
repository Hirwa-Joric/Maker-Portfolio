	(text "Every black return wire ends on TB1, which goes back to the car outlet through J1, W1 and P1.  No connection to the car body." (exclude_from_sim no) (at 147.32 153.035 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0e38d547-04c5-5bd7-813d-76cf79c4853a"))
	(text_box "1  POWER IN (from the car)\nP1 plugs into the car's own 12 V outlet. That outlet is live only when the car is on and has its own fuse in the car. Nothing in the car's wiring is cut, and the plug cannot go in backwards (the tip is always +).\nP1 holds the main 10 A fuse in its tip. W1 is 1.5 mm² (16 AWG) red/black twin, thick enough for 10 A. (Thinner 0.75-1.0 mm² wire would need a 7.5 A fuse instead.)\nJ1 lets the whole panel unplug from the lead. It must be rated 10 A or more, with a grommet or strain relief where W1 enters the board." (exclude_from_sim no) (at 15.24 81.28 0) (size 93.98 50.8) (margins 1.5 1.5 1.5 1.5) (stroke (width 0.2) (type solid)) (fill (type color) (color 255 253 235 1)) (effects (font (size 1.8 1.8)) (justify left top)) (uuid "4431c909-2fc2-5089-b4f2-b703cef9ba0d"))
	(text_box "2  FUSE BLOCK AND EARTH BUS\nSeparate branch fuses (F1-F4) are proposed for the devices and their wires. Verify fuse coordination and conductor ratings; protection is not established by this drawing.\nAll black returns meet on the earth bus bar TB1 (J-)." (exclude_from_sim no) (at 15.24 135.89 0) (size 93.98 31.75) (margins 1.5 1.5 1.5 1.5) (stroke (width 0.2) (type solid)) (fill (type color) (color 255 253 235 1)) (effects (font (size 1.8 1.8)) (justify left top)) (uuid "9bbec54d-1408-5c29-8d88-1cefec05ca7b"))
	(text_box "" (exclude_from_sim no) (at 15.24 170.18 0) (size 93.98 25.4) (margins 1.5 1.5 1.5 1.5) (stroke (width 0.2) (type solid)) (fill (type color) (color 255 255 255 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4d9cadaf-14b5-5e72-ab34-8576a572a867"))
